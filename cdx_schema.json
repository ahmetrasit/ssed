    "analytical": ["4.1_accuracy_concordance", "4.2.1_repeatability", "4.2.2_within_laboratory_precision", "4.2.3_reproducibility", "4.3.1_limit_of_blank", "4.3.2_limit_of_detection", "4.4_cross_reactivity", "4.5_interference_testing", "4.6_carryover_contamination", "4.7_input_range", "4.8_robustness_guardbanding"],
    "clinical": ["5.1_clinical_study_design", "5.2_clinical_sensitivity_specificity", "5.3_clinical_outcomes", "5.4_bridging_studies", "5.5_demographics", "5.6_sample_accountability", "5.7_subgroup_analyses"],
    "device_description": ["6.1_reagent_components", "6.2_instrumentation", "6.3_controls", "6.4_assay_workflow", "6.5_turnaround_time", "6.6_report_content"],
    "software": ["7.1_software_description", "7.2_bioinformatics_pipeline"],
    "stability": ["8.1_reagent_stability"],
    "risk": ["9.1_identified_hazards", "9.2_benefit_risk_assessment"],
    "labeling": ["10.1_warnings_and_precautions", "10.2_contraindications"],
    "post_market": ["11.1_conditions_of_approval", "11.2_post_approval_studies"],
    "additional_sections": ["12.1_alternative_devices", "12.2_marketing_history", "12.3_potential_adverse_effects", "12.4_panel_recommendation", "12.5_fda_conclusions", "12.6_references", "12.7_financial_disclosure"],
    "extensions": ["ext_ngs_sequencing_parameters", "ext_cdx_therapeutic_linkage", "ext_cdx_clinical_trial"],
    "uncategorized": ["99_uncategorized"]
  },

  "file_naming_convention": {
    "pattern": "{submission_number}/{sheet_id}.json",
    "example": "P210040B/4.3.2_limit_of_detection.json"
  },

  "metadata_file": {
    "name": "_metadata.json",
    "columns": {
      "submission_number": {"type": "string", "required": true},
